    {
      "name": "2. Get Driver",
      "item": [
        {
          "name": "Get Driver by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Returns the same driver\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.data.driverId).to.eql(pm.environment.get(\"driverId\"));\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/drivers/{{driverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "drivers",
                "{{driverId}}"
              ]
            }
          },
          "response": []
        }
