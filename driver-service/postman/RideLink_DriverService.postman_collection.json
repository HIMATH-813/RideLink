      "name": "3. Eligible Drivers",
      "item": [
        {
          "name": "Eligible - Colombo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Only AVAILABLE drivers in Colombo\", function () {\r\n    const drivers = pm.response.json().data;\r\n    pm.expect(drivers.length).to.be.above(0);\r\n    drivers.forEach(function (d) {\r\n        pm.expect(d.availabilityStatus).to.eql(\"AVAILABLE\");\r\n        pm.expect(d.serviceArea).to.eql(\"Colombo\");\r\n    });\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
