      "name": "1. Create Drivers",
      "item": [
        {
          "name": "Create Driver 1 - Colombo AVAILABLE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 201\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r\n});\r\n\r\npm.test(\"driverId generated\", function () {\r\n    const body = pm.response.json();\r\n    pm.expect(body.success).to.eql(true);\r\n    pm.expect(body.data.driverId).to.be.a(\"string\");\r\n    pm.environment.set(\"driverId\", body.data.driverId);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"userId\": \"user-001\",\r\n  \"serviceArea\": \"Colombo\",\r\n  \"vehicleDetails\": {\r\n    \"model\": \"Toyota Prius\",\r\n    \"registrationNumber\": \"CAB-1234\",\r\n    \"vehicleType\": \"CAR\",\r\n    \"color\": \"White\",\r\n    \"capacity\": 4\r\n  },\r\n  \"availabilityStatus\": \"AVAILABLE\",\r\n  \"location\": {\r\n    \"latitude\": 6.9271,\r\n    \"longitude\": 79.8612\r\n  },\r\n  \"rating\": 4.5\r\n}",
